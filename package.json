{
  "name": "poulstar-dockhosting-deploy-test",
  "version": "1.1.0",
  "private": true,
  "description": "Minimal React + NestJS JSON persistence demo for DockHosting",
  "engines": {
    "node": ">=20 <23"
  },
  "scripts": {
    "build": "tsc -p tsconfig.server.json && vite build src/frontend --outDir ../../web-dist --emptyOutDir",
    "start": "node server-dist/main.js",
    "dev:api": "npm run build:api && npm start",
    "build:api": "tsc -p tsconfig.server.json"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^18.3.20",
    "@types/react-dom": "^18.3.6",
    "typescript": "^5.8.3",
    "vite": "^5.4.19"
  }
}
